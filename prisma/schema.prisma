generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Building {
  id             String         @id @default(uuid())
  name           String
  latitude       Float
  longitude      Float
  approvalStatus ApprovalStatus @default(PENDING_REVIEW)
  surveyorId     String?
  verifiedAt     DateTime?
  floors         Floor[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([approvalStatus])
}

model Floor {
  id          String     @id @default(uuid())
  buildingId  String
  building    Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floorNumber Int
  elevation   Float
  height      Float
  units       Property[]

  @@unique([buildingId, floorNumber])
}

model Property {
  id         String   @id @default(uuid())
  floorId    String
  floor      Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  unitNumber String
  ulpin      String?  @unique
  area       Float
  spaceType  String
  polygon    Json
  createdAt  DateTime @default(now())
}